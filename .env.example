# Root Environment Configurations for Campus Twin
# See databricks/DATABRICKS_CONNECTION_GUIDE.md for detailed setup instructions.

# Databricks Genie Credentials (Used by Backend)
DATABRICKS_HOST=https://your-databricks-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_access_token_here
DATABRICKS_WAREHOUSE_ID=1234567890abcdef
GENIE_SPACE_ID=01ef0000-0000-0000-0000-000000000000
GENIE_AGENT_ID=01ef0000-0000-0000-0000-000000000000

# Backend Config
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MOCK_GENIE=true

# Frontend Config
NEXT_PUBLIC_API_URL=http://localhost:8000
